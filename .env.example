# ── Required ────────────────────────────────────────────────
# PostgreSQL hosted on Neon.tech (free tier) — paste the POOLED connection string.
DATABASE_URL="postgresql://user:password@ep-xxxx-xxxx.region.aws.neon.tech/ielts_master?sslmode=require"

# JWT secret — minimum 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-random-string-at-least-32-chars-long"

# Groq API key for AI writing/speaking evaluation (Llama 3.3). Free at console.groq.com.
# Without it the app still works using the built-in heuristic marker.
GROQ_API_KEY="gsk_change-me"

# ── Strongly recommended in production ──────────────────────
# Public URL of the deployment (canonicals, sitemap, OG tags, email links).
NEXT_PUBLIC_SITE_URL="https://your-domain.com"

# Resend (or compatible) transactional email — verification + reset + 2FA codes.
# With no key, codes are logged to the server console (dev mode only).
RESEND_API_KEY=""
MAIL_FROM="IELTS Master <no-reply@your-domain.com>"

# Extra origins allowed to POST to the API (CSRF allowlist). Comma separated.
# same-origin requests, localhost and *.vercel.app / *.e2b.app are already allowed.
ALLOWED_ORIGINS=""

# ── Optional hardening / scale ──────────────────────────────
# Redis-backed rate limiting so limits hold across serverless instances.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Google Search Console verification token (renders the meta tag).
GOOGLE_SITE_VERIFICATION=""

# Set a user's role to "admin" in the database to unlock /api/admin/analytics.
# UPDATE "User" SET role = 'admin' WHERE email = 'you@example.com';
